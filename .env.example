# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=fixmate

# Auth (Better Auth runs in the client app)
AUTH_URL=http://localhost:3000

# Frontend URL — used by CORS and Stripe success/cancel redirects
CLIENT_URL=http://localhost:3000

# Stripe (server-side only — never expose these in the browser)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Webhook signing secret from Stripe Developers -> Webhooks (or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional seed script settings
ADMIN_EMAIL=admin@fixmate.example
SEED_PASSWORD=REPLACE_ME
